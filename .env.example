# Copy to .env and fill in. Dummy values only. Never commit .env.
# On laptops other than PC 1, replace localhost with PC 1's LAN IP.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=streamguard
POSTGRES_TEST_DB=streamguard_test
POSTGRES_USER=streamguard
POSTGRES_PASSWORD=change_me

# Kafka
KAFKA_BOOTSTRAP=localhost:29092
# Host/IP that Kafka advertises to clients outside Docker (PC 1's LAN IP for team access)
KAFKA_HOST_IP=localhost

# Superset
SUPERSET_SECRET_KEY=replace-with-random-string
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change_me

# Monitoring thresholds
LAG_ALERT_THRESHOLD=5000
LATENCY_ALERT_SECONDS=30
