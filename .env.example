# Copy to .env and fill in. Dummy values only. Never commit .env.
# Single-PC setup (D-15): everything runs on this machine, so localhost everywhere.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=streamguard
POSTGRES_TEST_DB=streamguard_test
POSTGRES_USER=streamguard
POSTGRES_PASSWORD=change-me
# Login roles created by deploy/postgres/init (first start only)
SUPERSET_RO_PASSWORD=change-me
FEEDBACK_WRITER_PASSWORD=change-me

# Kafka
KAFKA_BOOTSTRAP=localhost:29092
# Host that Kafka advertises to clients outside Docker (this PC)
KAFKA_HOST_IP=localhost

# Superset
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(42))"
SUPERSET_SECRET_KEY=change-me
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me
SUPERSET_ADMIN_EMAIL=admin@example.com

# Monitoring thresholds (also override ops.health_config via scripts/apply_sql.py)
LAG_ALERT_THRESHOLD=5000
LATENCY_ALERT_SECONDS=30
